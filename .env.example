# The only secrets file. Load with: set -a; source .env; set +a
# Keep a copy in your password manager.

# Private config values. terraform.tfvars is committed and uses {domain} and
# {lan} placeholders for these (see private.tf).
TF_VAR_base_domain=          # e.g. example.com
TF_VAR_lan_prefix=           # e.g. 192.168.1 (Servers network)
TF_VAR_iot_prefix=           # e.g. 192.168.3 (IoT network, Home Assistant)
TF_VAR_acme_email=
TF_VAR_backup_bucket=
TF_VAR_state_bucket=

# Proxmox API token (pveum user token add root@pam tofu --privsep 0)
PROXMOX_VE_API_TOKEN=

# OpenTofu state: encryption passphrase (>= 16 chars) and the B2 key for the
# state bucket (its own key, not the backup key).
TF_VAR_state_passphrase=
B2_TFSTATE_KEY_ID=
B2_TFSTATE_TOKEN=
AWS_ACCESS_KEY_ID=$B2_TFSTATE_KEY_ID
AWS_SECRET_ACCESS_KEY=$B2_TFSTATE_TOKEN

# Let's Encrypt DNS-01 (VMs; and the Proxmox certificate via TF_VAR_).
CLOUDFLARE_DNS_API_TOKEN=
TF_VAR_cloudflare_dns_api_token=$CLOUDFLARE_DNS_API_TOKEN

# Tailscale auth key for the gateway VM (admin console -> Settings -> Keys).
# Only used for its first login; can be removed from Tailscale afterwards.
TAILSCALE_AUTHKEY=

# Audiobookshelf library in its own B2 bucket, mounted on the k3s VM (key
# limited to that bucket, read + write).
B2_AUDIOBOOKS_KEY_ID=
B2_AUDIOBOOKS_TOKEN=
B2_AUDIOBOOKS_BUCKET=

# restic backups to B2 (key limited to the backup bucket) and repository password.
B2_BACKUP_KEY_ID=
B2_BACKUP_TOKEN=
B2_BACKUP_RESTIC_PASSWORD=
